---
import type Document from '../data/document'
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Header from '../common/Header.astro'
import Footer from '../common/Footer.astro'
import { SiteMetadata } from '../common/config'
import Cover from '../countries/Penang.jpeg'
const documents = import.meta.glob<Document>('../data/*.json', { import: 'default', eager: true })
const trips = Object.keys(documents)
  .map((doc) => documents[doc])
  .flat(3)
  .filter((doc) => doc.collection === 'trip')
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
---

<Layout
  title="Trips"
  description="Index of all trips"
  date={SiteMetadata.buildTime}
  image={Cover}
  tags={['travel', 'blog']}
>
  <Header />
  <div class="px-12 py-12 bg-black w-full relative -mt-24">
    <!-- hero section -->
    <div class="py-48 text-center relative z-10">
      <h1 class="text-6xl text-white font-bold font-display mb-12 text-center">Trips</h1>
    </div>

    <!-- banner image -->
    <Image
      src={Cover}
      class="opacity-70 w-full inset-0 absolute object-cover object-center"
      alt="Cover"
    />
  </div>
  <div class="bg-rosely-black grid grid-cols-1 lg:grid-cols-3 md:grid-cols-2 xl:grid-cols-4">
    {
      trips.map((trip) => (
        <a
          href={trip.url}
          class="text-white tracking-widest font-heading bg-black flex h-72 block uppercase items-center justify-center relative"
        >
          <div class="relative z-10">{trip.title}</div>
          <img
            src={trip.image.src}
            class="opacity-50 h-full w-full inset-0 absolute object-cover hover:opacity-75"
            alt={trip.title}
          />
        </a>
      ))
    }
  </div>
  <Footer />
</Layout>
