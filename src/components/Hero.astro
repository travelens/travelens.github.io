---
import { Image } from 'astro:assets'

import NewYork from '../countries/New York.jpeg'
import Paris from '../countries/Paris.jpeg'
import Rome from '../countries/Rome.jpeg'

const bgSlide = '36s'
const bgImages = [NewYork, Paris, Rome]
---

<div
  class="bg-rosely-black flex h-screen w-full items-center justify-center relative overflow-hidden -mt-24"
>
  <div class="text-rosely-sugar px-6 text-center absolute z-10">
    <div class="text-xs tracking-widest uppercase">travelens</div>
    <h1 class="text-3xl font-display font-semibold mt-2 md:text-5xl">Travels Through A Lens</h1>
    <p class="mt-4">
      <a href="https://christham.net">Chris Tham</a>'s travelogue web site. This site documents all
      the trips we have taken over the years, to various countries.
    </p>
    <p class="mt-4 italic">
      This site is currently under construction, as we load trips from the most recent all the way
      back to our first trip in the 1980s.
    </p>
    <div class="mx-auto mt-6 gap-4 grid grid-cols-1 max-w-sm md:grid-cols-2">
      <a
        href="#places"
        class="hero-scroll text-sm text-rosely-sugar tracking-widest font-sans px-8 py-4 rounded-md bg-rosely-morning inline-block hover:bg-rosely-orchid"
      >
        Explore
      </a>
      <a
        href="#about"
        class="hero-scroll text-sm text-rosely-black tracking-widest font-sans px-8 py-4 rounded-md bg-rosely-rose inline-block hover:text-rosely-sugar hover:bg-rosely-morning"
      >
        About
      </a>
    </div>
  </div>
  <div class="opacity-50 h-full w-full left-0 top-0 absolute" id="hero-bgimg">
    {
      bgImages.map((image, i) => (
        <div
          class={`bgimg-slide opacity-0 h-full w-[130%] transition-opacity duration-[3s] left-0 top-0 absolute overflow-hidden${i === 0 ? ' bgactive' : ''}`}
        >
          <Image src={image} class="h-full w-full object-cover" alt="" />
        </div>
      ))
    }
  </div>
</div>

<script>
  const bgimg = document.getElementById('hero-bgimg')
  if (bgimg) {
    const slides = Array.from(bgimg.querySelectorAll(':scope > div'))
    let current = 0
    setInterval(() => {
      slides[current].classList.remove('bgactive')
      current = (current + 1) % slides.length
      slides[current].classList.add('bgactive')
    }, 6000)
  }

  document.querySelectorAll<HTMLAnchorElement>('a.hero-scroll').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault()
      const target = document.querySelector(link.getAttribute('href') ?? '')
      target?.scrollIntoView({ behavior: 'smooth' })
    })
  })
</script>

<style define:vars={{ bgSlide }}>
  .bgimg-slide {
    animation: bg var(--bgSlide) linear infinite;

    @media only screen and (max-width: 1280px) {
      animation: bg calc(var(--bgSlide) * 0.65) linear infinite;
    }

    @media only screen and (max-width: 768px) {
      animation: bg calc(var(--bgSlide) * 0.4) linear infinite;
    }
  }

  .bgactive {
    opacity: 1;
  }

  @keyframes bg {
    0% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(-15%);
    }
  }
</style>
