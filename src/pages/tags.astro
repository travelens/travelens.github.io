---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Header from '../common/Header.astro'
import Footer from '../common/Footer.astro'
import { SiteMetadata } from '../common/config'
import type Document from '../data/document'
import Cover from '../images/tags.jpeg'

const documents = import.meta.glob<Document[]>('../data/*.json', { import: 'default', eager: true })
const tags = Object.keys(documents)
  .map((doc) => documents[doc].map((entry) => (entry.tags ? entry.tags.split(':') : [])))
  .flat(3)
  .sort()
const tagcount = tags.reduce((acc: Record<string, number>, curr) => {
  acc[curr] = (acc[curr] || 0) + 1
  return acc
}, {})

const colors = [
  'bg-rosely-rose',
  'bg-rosely-barely',
  'bg-rosely-heavenly',
  'bg-rosely-lavender',
  'bg-rosely-lupine'
]

const textSize = [
  'text-xs',
  'text-sm',
  'text-base',
  'text-lg',
  'text-xl',
  'text-2xl',
  'text-3xl',
  'text-4xl'
]
const maxcount =
  tagcount[Object.keys(tagcount).reduce((a, b) => (tagcount[a] > tagcount[b] ? a : b))]
---

<Layout
  title="Tags"
  description="Index of all tags"
  date={SiteMetadata.buildTime}
  image={Cover}
  tags={['travel', 'blog']}
>
  <Header />
  <div class="px-6 py-6 bg-black h-full w-full relative -mt-24">
    <!-- hero section -->
    <div class="text-center relative z-10">
      <h1 class="text-6xl text-white font-bold font-display mb-6 mt-12 text-center">Tags</h1>
      <ul class="align-center leading-10 flex flex-wrap justify-center">
        {
          Object.keys(tagcount).map((tag, i) => (
            <li>
              <a
                href={'/tag/' + encodeURIComponent(tag)}
                class:list={[
                  'text-rosely-black m-2 p-1 hover:p-2 hover:m-1 shadow-md shadow-rosely-opal hover:shadow-rosely-granite rounded-full',
                  colors[i % colors.length],
                  textSize[Math.floor((tagcount[tag] * textSize.length) / maxcount)]
                ]}
              >
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- banner image -->
    <Image src={Cover} class="opacity-70 h-full inset-0 absolute object-cover" alt="Cover" />
  </div>
  <Footer />
</Layout>
