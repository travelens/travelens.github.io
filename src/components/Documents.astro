---
import Tags from '../common/Tags.astro'

interface Doc {
  id: string
  url: string
  collection: string
  body: string
  trip: string
  place: string
  timezone: string
  location: string
  title: string
  description: string
  date: Date
  image: ImageMetadata
  map: number[]
  tags: string
}

export interface Props {
  documents: Doc[]
}

const { documents } = Astro.props
---

{
  documents.map((doc, i) => (
    <div class="mx-auto mb-4 px-6 py-4 rounded-lg bg-rosely-heavenly container grid grid-cols-1 shadow-md shadow-rosely-opal lg:grid-cols-2">
      <div class="h-52 relative lg:h-auto md:h-72">
        <a href={doc.url}>
          <img
            src={doc.image.src}
            width={1024}
            class="p-4 bg-white h-full w-full inset-0 absolute object-cover hover:bg-rosely-rose"
            alt={doc.title}
          />
        </a>
      </div>
      <div
        class="px-6 py-12 flex items-center justify-center order-last lg:p-32 md:p-16"
        class:list={[i % 2 == 0 && 'lg:order-first']}
      >
        <div>
          <a href={doc.url}>
            <h3 class="text-4xl text-rosely-black leading-tight font-display mb-2 hover:text-rosely-morning">
              {doc.title}
            </h3>
          </a>
          <div class="text-rosely-granite my-2">
            <div>
              <span class="i-fa6-solid-passport h-4 w-4" />
              <span class="ml-1 mr-4">{doc.trip}</span>
            </div>
            <div>
              <span class="i-fa6-solid-globe h-4 w-4" />
              <span class="ml-1 mr-4">{doc.place}</span>
            </div>
            <div>
              <span class="i-fa6-solid-location-arrow h-4 w-4" />
              <span class="ml-1 mr-4">{doc.location}</span>
            </div>
            <div>
              <span class="i-fa6-solid-calendar-days h-4 w-4" />
              <span class="ml-1">
                {new Date(doc.date).toLocaleString('en-AU', {
                  dateStyle: 'long',
                  timeStyle: 'short',
                  timeZone: doc.timezone
                })}
              </span>
            </div>
            <Tags tags={doc.tags ? doc.tags.split(':') : []} />
          </div>
          <p>{doc.description}</p>
          <a
            href={doc.url}
            class="text-sm text-white tracking-widest font-heading mt-4 px-8 py-4 bg-rosely-morning inline-block hover:bg-rosely-orchid"
          >
            Read
          </a>
        </div>
      </div>
    </div>
  ))
}
