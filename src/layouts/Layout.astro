---
import Metadata from '../common/Metadata.astro'

export interface Props {
  title: string
  description: string
  date: Date
  image: ImageMetadata
  tags?: string[]
}

const { title, description, date, tags, image } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4eee8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="travelens RSS Feed" href="/rss.xml" />
    <Metadata title={title} description={description} date={date} image={image} tags={tags} />
  </head>
  <body class="text-rosely-granite font-sans bg-rosely-sugar antialiased">
    <a
      href="#main-content"
      class="text-rosely-sugar font-sans px-4 py-2 rounded bg-rosely-orchid z-50 sr-only focus:left-4 focus:top-4 focus:absolute focus:not-sr-only"
      >Skip to main content</a
    >
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
