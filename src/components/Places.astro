---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'

const places = await getCollection('place')
---

<div
  id='places'
  class='grid grid-cols-1 gap-4 p-4 lg:grid-cols-5 lg:grid-rows-2 lg:h-screen md:grid-cols-3'
>
  {
    places.map((place) => (
      <a
        href={'/place/' + place.id}
        class:list={[
          'group relative block bg-black text-white',
          'md:col-span-' + place.data.width,
          'transition-opacity duration-500 shadow-lg shadow-neutral-400 rounded-lg'
        ]}
      >
        <div class='relative z-10 p-12 lg:p-12 md:p-6'>
          <h3 class='font-display text-2xl'>{place.data.title}</h3>
          <p class='mt-2 text-sm'>{place.data.description}</p>
          <div class='font-sans mt-6 inline-block bg-rosely-rose px-8 py-4 text-sm text-rosely-black tracking-widest transition-colors duration-300 hover:bg-rosely-morning hover:text-white'>
            View Trips
          </div>
        </div>
        <Image
          src={place.data.image}
          width={2048}
          alt={place.data.title}
          class='absolute inset-0 h-full w-full rounded-lg object-cover opacity-50 transition-opacity duration-500 group-hover:opacity-25'
        />
      </a>
    ))
  }
</div>
<div class='py-12 text-center'>
  <a
    href='/trips'
    class='font-sans inline-block bg-rosely-morning px-8 py-4 text-sm text-white tracking-widest hover:bg-rosely-orchid'
    >View All Trips</a
  >
</div>
