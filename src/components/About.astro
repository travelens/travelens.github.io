---
import { Image } from 'astro:assets'

import Chris from '../images/Chris.jpeg'
import Ghan from '../images/The Ghan.jpeg'
import Rome from '../countries/Rome 2.jpeg'
---

<div id="about" class="px-12 py-12">
  <div class="mx-auto container flex flex-wrap">
    <div class="mb-12 flex flex-wrap w-full md:mb-0 md:pr-4 md:w-1/2">
      <div class="p-2 w-1/2">
        <Image
          src={Chris}
          alt="Chris"
          class="p-4 bg-white h-64 w-full shadow-md shadow-rosely-opal object-cover"
        />
      </div>
      <div class="p-2 w-1/2">
        <Image
          src={Rome}
          alt="Rome"
          class="p-4 bg-white h-64 w-full shadow-md shadow-rosely-opal object-cover"
        />
      </div>
      <div class="p-2 w-full">
        <Image
          src={Ghan}
          alt="The Ghan"
          class="p-4 bg-white h-64 w-full shadow-md shadow-rosely-opal object-cover"
        />
      </div>
    </div>
    <div class="w-full md:pl-4 md:w-1/2">
      <div class="text-sm text-rosely-morning tracking-widest uppercase">travelens</div>
      <h2 class="text-5xl font-bold font-display mb-10">Travels Through A Lens</h2>
      <div class="max-w-lg">
        <p class="text-rosely-granite mb-6">I live in Sydney, but love travelling.</p>
        <p class="text-rosely-granite mb-6">
          of the wonderful trips we have taken across many countries, and I hope you enjoy them as
          much as we did taking them.
        </p>
        <p class="text-rosely-granite mb-2">My personal site:</p>
        <a
          href="https://christham.net"
          class="text-sm text-white tracking-widest font-sans px-8 py-4 bg-rosely-morning inline-block hover:bg-rosely-orchid"
          >ChrisTham.net</a
        >
        <p class="text-rosely-granite mb-2 mt-6">
          My professional world travel and photography site:
        </p>
        <a
          href="https://visualvoyager.net"
          class="text-sm text-rosely-black tracking-widest font-sans px-8 py-4 bg-rosely-rose inline-block hover:text-white hover:bg-rosely-morning"
        >
          VisualVoyager.net
        </a>
      </div>
    </div>
  </div>
</div>
